@baseUrl = http://localhost:3333
@token = {{SignIn.response.body.$.accessToken}}

# !! Pega só o primeiro refreshToken, se tentar dnv da 401
@refreshToken = {{SignIn.response.headers.set-cookie}}

# @name Health
GET {{baseUrl}}/health

###

# @name SignUp
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "name": "Nathan Rodrigues Vieira",
  "email": "nathanrodriguesvieira99@gmail.com",
  "password": "12345678",
  "birthDate": "2005-09-26T00:00:00.000Z",
  "role": "ADMIN",
  "documentType": "CPF",
  "document": "207.767.427-01"
}

###

# @name SignIn 
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{
  "email":"nathanrodriguesvieira99@gmail.com",
  "password":"12345678"
}

###

# @name refresh
POST {{baseUrl}}/auth/refresh
Cookie: {{refreshToken}}

###

# @name logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

###

# @name upload_avatar
POST {{baseUrl}}/accounts/me/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="test.jpg"

< ./src/test/images/test.jpg

--boundary--

###

# @name user_profile
GET {{baseUrl}}/accounts/me
Authorization:  Bearer {{token}}
Content-Type: application/json

###

# @name all_users
GET {{baseUrl}}/accounts/users?page=1&limit=10
Authorization:  Bearer {{token}}
Content-Type: application/json

###

# @name edit_profile
PATCH {{baseUrl}}/accounts/me
Authorization:  Bearer {{token}}
Content-Type: application/json

{
  "name": "Nathan Rodrigues Vieira"
}

###

# @name delete_profile
DELETE  {{baseUrl}}/accounts/me
Authorization:  Bearer {{token}}
Content-Type: application/json

###

# @name user_appointments
GET {{baseUrl}}/appointments
Authorization:  Bearer {{token}}

###

# @name list_professionals
GET {{baseUrl}}/professionals?page=1&limit=10
Authorization:  Bearer {{token}}
