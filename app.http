@baseUrl = http://localhost:3333
@authToken = {{SignIn.response.body.accessToken}}

# 🔓 ROTAS PÚBLICAS (sem autenticação)

### 
# Cadastrar um usuário
# @name SignUp
POST {{baseUrl}}/auth/signup
Content-Type: application/json
 
 {
  "name": "Frey", // sempre alterar para evitar conflitos ao testar
  "email": "father2@acme.com", // sempre alterar para evitar conflitos ao testar
  "password": "12345678",
  "birthDate": "1990-01-01T00:00:00.000Z", 
  "role": "PATIENT",
  "documentType": "CPF",
  "document": "153.566.329-99" // sempre alterar para evitar conflitos ao testar
}

###
# fazer login para obter token jwt
# @name SignIn
POST {{baseUrl}}/auth/signin
Content-Type: application/json
 
 {
  "email": "father2@acme.com", // usar o mesmo email do @SignUp
  "password": "12345678"
}

###

# 👤 ROTAS DE USUÁRIOS (com autenticação)

# ver o perfil do usuário logado
# @name get_user_profile
GET {{baseUrl}}/accounts/me
Authorization: Bearer {{authToken}}

### 

# deletar um perfil de usuário
# @name delete_user_profile
DELETE {{baseUrl}}/accounts/me
Authorization: Bearer {{authToken}}

###

# paciente listar os profissionais
# @name list_professionals
GET {{baseUrl}}/accounts/professionals
Authorization: Bearer {{authToken}}

###

# paciente edita o perfil
# @name edit_profile
PATCH {{baseUrl}}/accounts/me
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name":"Patch da silva",
  "email": "patch@email.com"
}

###
