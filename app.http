@baseUrl = http://localhost:3333

# @name Health
GET {{baseUrl}}/health

###

# 👇👇👇 repassar manualmente os tokens JWT (access e refresh),
# pois não funciona repassar dinamicamente vindo dos cookies

# @name SignUp
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "name": "Nathan Rodrigues Vieira",
  "email": "nathanrodriguesvieira99@test.com",
  "password": "12345678",
  "birthDate": "2005-09-26T00:00:00.000Z",
  "role": "ADMIN",
  "documentType": "CPF",
  "document": "999.999.999-99"
}

###

# @name SignIn 
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{
  "email":"nathanrodriguesvieira99@test.com",
  "password":"12345678"
}

###

# @name refresh
POST {{baseUrl}}/auth/refresh
Cookie: refreshToken=

###


# @name logout
POST {{baseUrl}}/auth/logout
Cookie: accessToken=

###


# @name upload_avatar
POST {{baseUrl}}/accounts/me/avatar
Cookie: accessToken=
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="test.jpg"

< ./src/test/images/test.jpg

--boundary--

###


# @name user_profile
GET {{baseUrl}}/accounts/me
Cookie: accessToken=
Content-Type: application/json

###


# @name all_users
GET {{baseUrl}}/accounts/users?page=1&limit=10
Cookie: accessToken=
Content-Type: application/json

###


# @name edit_profile
PATCH {{baseUrl}}/accounts/me
Cookie: accessToken=
Content-Type: application/json

{
  "name": "Nathan Rodrigues Vieira"
}

###


# @name delete_profile
DELETE  {{baseUrl}}/accounts/me
Cookie: accessToken=
Content-Type: application/json

###


# @name user_appointments
GET {{baseUrl}}/appointments
Cookie: accessToken=

###

# @name list_professionals
GET {{baseUrl}}/professionals?page=1&limit=10
Cookie: accessToken=
