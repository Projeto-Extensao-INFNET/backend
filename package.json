{
  "name": "backend_projeto_extensao",
  "version": "0.0.1",
  "description": "Backend do meu projeto de extensão da faculdade",
  "author": "Nathan Rodrigues Vieira",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.1"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "lint": "eslint --ext .ts,.js \"src\" --fix",
    "prepare": "husky",
    "test:k6": "k6 run k6/scripts/load.ts",
    "test:unit": "dotenv -e .env.test -- vitest run --config ./test/unit/vitest.config.ts",
    "test:unit:watch": "dotenv -e .env.test -- vitest --config ./test/unit/vitest.config.ts",
    "test:unit:cov": "dotenv -e .env.test -- vitest run --coverage --config ./test/unit/vitest.config.ts",
    "test:int": "dotenv -e .env.test -- vitest run --config ./test/integration/vitest.config.int.ts",
    "test:int:watch": "dotenv -e .env.test -- vitest --config ./test/integration/vitest.config.int.ts",
    "test:int:cov": "dotenv -e .env.test -- vitest run --coverage --config ./test/integration/vitest.config.int.ts",
    "pretest:e2e": "dotenv -e .env.test prisma migrate deploy",
    "test:e2e": "dotenv -e .env.test -- vitest run --config ./test/e2e/vitest.config.e2e.ts",
    "test:e2e:cov": "dotenv -e .env.test -- vitest run --coverage --config ./test/e2e/vitest.config.e2e.ts",
    "test:all": "pnpm test:unit && pnpm test:int && pnpm test:e2e && pnpm test:k6",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "pnpm prisma db seed",
    "docker:dev": "cd docker && docker compose up --build",
    "docker:stop": "cd docker && docker compose stop"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.17.2",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.13.2",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/testing": "^11.1.12",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/k6": "^1.7.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prisma": "^7.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
