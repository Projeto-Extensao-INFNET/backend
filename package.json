{
  "name": "backend_projeto_extensao",
  "version": "0.0.1",
  "description": "",
  "author": "Nathan Rodrigues Vieira",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.1"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "lint": "eslint --ext .ts,.js \"src\" --fix",
    "prepare": "husky",
    "commit": "cz",
    "test": "dotenv -e .env.test vitest run --bail 1",
    "test:watch": "dotenv -e .env.test -- vitest --bail 1",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage --no-file-parallelism",
    "pretest:e2e": "dotenv -e .env.test pnpm dlx prisma migrate deploy",
    "test:e2e": "dotenv -e .env.test -- vitest run --config ./vitest.config.e2e.ts",
    "test:coverage:e2e": "dotenv -e .env.test -- vitest run --config vitest.config.e2e.ts --coverage",
    "prisma:migrate": "pnpm dlx prisma migrate dev",
    "prisma:generate": "pnpm dlx prisma generate",
    "prisma:studio": "pnpm dlx prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:stop:dev": "docker compose -f docker-compose.dev.yml stop",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:stop:prod": "docker compose -f docker-compose.prod.yml stop"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.19",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
